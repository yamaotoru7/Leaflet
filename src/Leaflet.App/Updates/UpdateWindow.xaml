<Window x:Class="Leaflet.App.Updates.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新" Width="560" Height="460" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="Yu Gothic UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Headline" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Subline" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,4,0,12" />
        </StackPanel>
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Padding="10,6">
            <!-- Release notes are Markdown; MarkdownDocument renders them. -->
            <FlowDocumentScrollViewer x:Name="Notes" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False" />
        </Border>
        <TextBlock x:Name="ProgressText" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Click="OpenPage" Content="リリースページ" Padding="12,4" />
            <Button x:Name="InstallButton" DockPanel.Dock="Right" Click="InstallClick" Content="更新して再起動"
                    MinWidth="120" Padding="12,4" IsDefault="True" />
            <Button DockPanel.Dock="Right" Click="LaterClick" Content="後で" MinWidth="76" Padding="12,4" Margin="0,0,8,0" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
